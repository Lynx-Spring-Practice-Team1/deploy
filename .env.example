# Copy this file to .env and fill in your values
# Never commit .env to git

# PostgreSQL
POSTGRES_USER=broker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=auth_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Redpanda (Kafka-compatible)
REDPANDA_KAFKA_PORT=9092
REDPANDA_KAFKA_EXTERNAL_PORT=19092
REDPANDA_CONSOLE_PORT=8090

# JWT — use a long random string in production
JWT_SECRET=change-this-to-a-256-bit-secret-key-before-any-real-use
JWT_EXPIRY_MINUTES=60

# Exchange endpoints — update these to wherever the exchange is running
EXCHANGE_REST_API_URL=http://host.docker.internal:8080
EXCHANGE_WS_URL=ws://host.docker.internal:8080/ws

# Service ports (exposed to host for local development/debugging)
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002
WALLET_SERVICE_PORT=8003
PORTFOLIO_SERVICE_PORT=8004
MARKET_NOTIFICATIONS_PORT=8005
FRONTEND_PORT=3000
