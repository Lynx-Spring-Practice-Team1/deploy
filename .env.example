# Copy this file to .env and fill in your values
# Never commit .env to git

# PostgreSQL
POSTGRES_USER=broker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=auth_db
POSTGRES_PORT=5432

# Redis host port. The container still listens on 6379.
REDIS_PORT=6380

# Redpanda host ports. The container still listens on 9092/19092.
REDPANDA_KAFKA_PORT=9093
REDPANDA_KAFKA_EXTERNAL_PORT=19093
REDPANDA_CONSOLE_PORT=8090

# JWT - use a long random string in production
JWT_SECRET=change-this-to-a-256-bit-secret-key-before-any-real-use
JWT_EXPIRY_MINUTES=60

# Full Exchange stack endpoints
# EXCHANGE_API_BASE_URL / EXCHANGE_WS_URL are used server-side only (order-service, market-notifications).
# EXCHANGE_API_KEY / EXCHANGE_API_SECRET never reach the browser — the frontend connects to
# your own /api/ws relay endpoint using its JWT instead.
EXCHANGE_API_BASE_URL=http://host.docker.internal:8085
EXCHANGE_WS_URL=ws://178.105.22.233:8084/ws
EXCHANGE_API_KEY=test-key
EXCHANGE_API_SECRET=test-secret

# Service ports exposed to host for local development/debugging
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002
WALLET_SERVICE_PORT=8003
PORTFOLIO_SERVICE_PORT=8004
MARKET_NOTIFICATIONS_PORT=8005
PRICE_HISTORY_SERVICE_PORT=3001
FRONTEND_PORT=3000
